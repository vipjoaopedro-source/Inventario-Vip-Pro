{
  "name": "Contagem de Mercadorias",
  "short_name": "Contagem",
  "description": "Contagem de estoque por área, direto do celular.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#141b26",
  "theme_color": "#141b26",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "display_override": ["standalone", "minimal-ui", "browser"],
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": { "client_mode": "navigate-existing" },
  "edge_side_panel": { "preferred_width": 420 },
  "scope_extensions": [],

  "shortcuts": [
    { "name": "Nova contagem", "short_name": "Contagem", "url": "/nova" },
    { "name": "Configurações", "short_name": "Config", "url": "/config" }
  ],
  "screenshots": [
    { "src": "/screenshot-mobile.png", "sizes": "412x915", "type": "image/png", "form_factor": "narrow", "label": "Tela inicial da contagem" },
    { "src": "/screenshot-desktop.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Tela inicial da contagem" }
  ],
  "icons": [
    { "src": "/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
